<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Deco circles -->
    <View android:layout_width="260dp" android:layout_height="260dp"
        android:alpha="0.06" android:background="@drawable/bg_circle_deco"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-60dp" android:layout_marginEnd="-60dp" />
    <View android:layout_width="180dp" android:layout_height="180dp"
        android:alpha="0.05" android:background="@drawable/bg_circle_deco"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-50dp" android:layout_marginStart="-50dp" />

    <!-- Center group: logo + name + tagline -->
    <LinearLayout
        android:id="@+id/center_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        android:scaleX="0.6"
        android:scaleY="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Instagram-style gradient logo box -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center">
            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_logo_gradient" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="#"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="HashKit"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Divider -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:background="#66FFFFFF" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Your Social Media Superkit"
            android:textColor="#BBFFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bottom: developer photo + credit -->
    <LinearLayout
        android:id="@+id/tv_dev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="44dp">

        <!-- Circular developer photo -->
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/dev_photo"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_photo_circle"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by Mukesh Kumar"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
