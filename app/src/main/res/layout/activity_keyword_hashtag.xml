<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar" android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_toolbar_dark" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Enter Keywords" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Separate multiple keywords with comma  (e.g: food, travel, sunset)"
                android:textColor="#8899BB" android:textSize="12sp" android:layout_marginBottom="10dp" />

            <EditText android:id="@+id/et_keywords"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:background="@drawable/bg_input_dark"
                android:paddingHorizontal="16dp"
                android:hint="Type keywords here..."
                android:textColor="#EEEEFF" android:textSize="15sp"
                android:inputType="text" android:imeOptions="actionDone" />

            <!-- Category quick-select chips -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Quick select:" android:textColor="#8899BB"
                android:textSize="12sp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:id="@+id/chip_row" />
            </HorizontalScrollView>

            <TextView android:id="@+id/btn_generate"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:gravity="center" android:text="⚡  Generate Hashtags"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_generate"
                android:clickable="true" android:focusable="true" />

        </LinearLayout>

        <!-- Results -->
        <LinearLayout android:id="@+id/layout_results"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="20dp"
            android:visibility="gone">

            <!-- Instagram tip -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_tip_box" android:padding="12dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💡" android:textSize="18sp" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Instagram Tip: Use only Top 5 hashtags in your caption. Paste all 30 in your FIRST COMMENT for maximum reach!"
                    android:textColor="#FFCCFF" android:textSize="12sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Top 5 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="⭐ Top 5 Trending (Use in Caption)"
                    android:textColor="#FFD700" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/btn_copy_top5"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:gravity="center" android:text="Copy" android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/bg_btn_copy" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <TextView android:id="@+id/tv_top5"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_tip_box" android:padding="14dp"
                android:textColor="#FFFACD" android:textSize="14sp" android:lineSpacingExtra="5dp"
                android:layout_marginBottom="14dp" />

            <!-- All 30 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="📋 All 30 Hashtags (Paste in First Comment)"
                    android:textColor="#AABBFF" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/btn_copy_all"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:gravity="center" android:text="Copy All" android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/bg_btn_copy" android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <TextView android:id="@+id/tv_all_tags"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_result_box" android:padding="14dp"
                android:textColor="#BBCCFF" android:textSize="13sp" android:lineSpacingExtra="5dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
